{$DOMAIN} {
    # EcoCash webhook endpoint — direct route to ecocash-service HTTP server
    handle /webhooks/ecocash/* {
        reverse_proxy ecocash-service:8018
    }

    # All other routes → api-gateway (GraphQL, REST)
    reverse_proxy api-gateway:8080
}

media.{$DOMAIN} {
    reverse_proxy media-service:8087
}

docs.{$DOMAIN} {
    reverse_proxy documentation-service:8085
}

