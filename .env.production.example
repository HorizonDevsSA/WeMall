# Domain for Caddy reverse proxy
DOMAIN=api.yourdomain.com

# Database Configuration
DB_USER=wemall
DB_PASSWORD=generate_a_very_secure_password_here

# JWT Secret for Auth
JWT_SECRET=generate_a_long_secure_random_string_here

# Redis
REDIS_PASSWORD=generate_redis_password_here

# Meilisearch
MEILI_MASTER_KEY=generate_meili_master_key_here

# Stripe
STRIPE_SECRET_KEY=sk_live_...

# EcoCash EIP (production credentials from EcoCash merchant portal)
ECOCASH_BASE_URL=https://developers.ecocash.co.zw/payment/v1
ECOCASH_USERNAME=
ECOCASH_PASSWORD=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_COUNTRY_CODE=ZW
ECOCASH_MERCHANT_NAME=WeMall
ECOCASH_SUPER_MERCHANT=
# Must be the public HTTPS URL EcoCash can reach for webhook callbacks
# e.g. https://api.yourdomain.com
WEBHOOK_BASE_URL=https://api.yourdomain.com
WEBHOOK_SECRET_PATH=/webhooks/ecocash/callback
